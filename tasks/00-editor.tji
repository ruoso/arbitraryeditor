# 00 — Editor (host GUI over libarbc)
#
# The Arbitrary Composer Editor: a native C++ desktop application that uses
# libarbc (v0.1+) as a still-image compositor where cells are placed by
# arbitrary affine and observed by cameras. Design is fully specified in
# docs/00-design.md (D1-D19) and docs/01-architecture.md (A1-A7); each leaf note
# cites the governing decision. Refinements land under tasks/refinements/.
#
# libarbc is an EXTERNAL dependency, consumed via CMake FetchContent from a git
# ref (github.com/ruoso/arbitrarycomposer) — it is not part of this WBS. A leaf
# that needs a library capability the released surface does not yet expose files
# that gap as a task in the LIBRARY repo, releases it, and consumes it here.
#
# Build order flows roughly top-to-bottom: foundation -> dockspace -> project &
# app state -> canvas -> cameras/cells -> panels/paint/import -> packaging.
#
# DEFINITION OF DONE (every leaf — docs/01-architecture.md §9, A8/A9 — NOT
# standalone leaves): respects the levelization DAG (check_levels clean); lands
# its tests (L1 logic -> Catch2 unit; renders -> render_offline golden; has UI ->
# an ImGui Test Engine e2e; threads -> ASan/TSan-clean); clang-format + build
# clean; scripts/gate green. foundation.build stands up the harness, the
# check_levels lint, the component skeleton, and scripts/gate so this bar is
# satisfiable from the first task. Each refinement's Acceptance-criteria section
# names the SPECIFIC tests that instantiate the DoD for its leaf.

task editor "Editor — host GUI over libarbc" {
  note "Every leaf carries the universal DEFINITION OF DONE (see file header / docs/01-architecture.md §9): levelization (check_levels) + layered tests (Catch2 L1 unit, render_offline goldens, ImGui Test Engine e2e for UI, ASan/TSan for threads) + format/build, all via scripts/gate. These are acceptance criteria on every task, not separate leaves."

  # ---- Foundation & scaffold (A1/A2/A3) ----
  task foundation "Foundation & scaffold" {
    task build "CMake, deps, presets, CI" {
      effort 2d
      allocate team
      complete 100
      note "Bootstrapped BY HAND (the loop cannot produce its own gate). CMakeLists.txt FetchContents libarbc as a subproject — arbc::arbc linked, binding proven by a Catch2 test — plus presets (dev/release/asan/tsan/coverage); the src/ 12-component skeleton (§7/§8 levels); scripts/check_levels.py enforcing the level DAG AND the A8 seam (the L1 core carries no ImGui/GL/SDL/libarbc leak); the Catch2 L1 test harness; scripts/gate (check_levels · clang-format · build · ctest); and the GitHub CI (ci.yml lint + gcc/clang × debug/release/asan/tsan + coverage) with the act runner for the orchestrator's in-loop replay. All green. SDL3 + Dear ImGui (docking) + the window/dockspace + the ImGui Test Engine harness land with app_shell. Arch A1/A2/A8/A9. Design: docs/01-architecture.md §7-§9. Refinement: tasks/refinements/foundation_build.md"
    }
    task app_shell "SDL3 window + GL context + ImGui + main loop" {
      effort 2d
      allocate team
      complete 100
      depends !build
      note "FetchContent SDL3 + Dear ImGui (docking branch). Open a window, create an OpenGL context targeting the GLES3/WebGL2-common subset, init Dear ImGui with the SDL3+GL backends, run the frame loop. Self-rendered UI only (no native widgets) so the WASM target stays reachable. Being the FIRST ImGui surface, also stand up the ImGui Test Engine e2e harness + an offscreen-GL headless smoke — the DoD's UI-test rig every later view leaf uses. Arch A2/A3/A9. Refinement: tasks/refinements/editor/app_shell.md"
    }
    task platform_services "PlatformServices seam (file / threads / clock)" {
      effort 2d
      allocate team
      complete 100
      depends !app_shell
      note "A thin interface over directory/file access, thread spawn, and clock; native implementation (std filesystem + threads). The one seam the future web port swaps (File System Access / OPFS / Emscripten pthreads) without touching app or UI code. Arch A3. Refinement: tasks/refinements/foundation/platform_services.md"
    }
    task render_probe "Render a trivial Document into a canvas texture" {
      effort 2d
      allocate team
      complete 100
      depends !app_shell
      note "Build a trivial libarbc Document in-process, render it into a CPU surface, upload as a GL texture, display it in one ImGui pane. Proves the binding + display path end to end and surfaces any library gap early. Arch A1/A6. Refinement: tasks/refinements/foundation/render_probe.md"
    }
  }

  # ---- Dockspace shell (D18) ----
  task dock "Dockspace shell" {
    task dockspace "Split-tree + tabs over ImGui docking" {
      effort 3d
      allocate team
      complete 100
      depends editor.foundation.app_shell
      note "A fully-uniform dockspace on ImGui's docking branch: recursive split containers, tabbed views, drag-to-dock, resize. No privileged editor area, no keep-a-canvas guardrail. Design: docs/00-design.md D18. Refinement: tasks/refinements/editor/dockspace.md"
    }
    task view_registry "View abstraction: open / close / reopen" {
      effort 2d
      allocate team
      complete 100
      depends !dockspace
      note "Register view types (Canvas, Layers, Inspector, Overview, Color, History, Assets, Export) and instantiate them into any container; a view can be closed and reopened. Underpins 'anything can be closed'. Design: D18. Refinement: tasks/refinements/editor/view_registry.md"
    }
    task tool_rail "Fixed tool rail + view launcher (home base)" {
      effort 1.5d
      allocate team
      complete 100
      depends !view_registry
      note "The thin left rail: modal tools (select/brush/eyedropper/camera/import/pan) plus the view launcher that reopens any closed view. Since anything (even every canvas) can be closed, the rail is the home base that can never leave you empty. Design: D18. Refinement: tasks/refinements/editor/tool_rail.md"
    }
    task workspaces "Saved layout presets (local UI state)" {
      effort 2d
      allocate team
      complete 100
      depends !dockspace, editor.foundation.platform_services
      note "Named workspace presets (Paint/Compose/Review) switchable in a click; the layout tree persists as LOCAL UI state in workspace/ or global prefs, never in the portable project.arbc. Design: D18 / §9. Refinement: tasks/refinements/editor.dock/workspaces.md"
    }
  }

  # ---- Project & app state (A4/A7, D16/D19) ----
  task project "Project & app state" {
    task open "Open a project directory; new project" {
      effort 2d
      allocate team
      complete 100
      depends editor.foundation.render_probe
      note "Open a project DIRECTORY (project.arbc + assets/ + workspace/): map the workspace or load the canonical doc; create a new project scaffolding the directory. Design: D16. Refinement: tasks/refinements/editor/open.md"
    }
    task open_ui "In-app New/Open affordance; recent projects; native folder picker" {
      effort 2d
      allocate team
      complete 100
      depends !exec_new, editor.dock.tool_rail
      note "File-menu / tool-rail New and Open entries, a recent-projects list persisted to per-user prefs, and a native folder picker (SDL_ShowOpenFolderDialog behind a PlatformServices dialog seam), wiring the chosen path to ace::project::open_project / create_project and, for open-another, to editor.project.exec_new (new exec, A7/D19). Design: docs/00-design.md D16, D19. Source-of-debt refinement: tasks/refinements/editor/open.md. Refinement: tasks/refinements/editor/open_ui.md"
    }
    task app_state "Project-level state; single Document per process; command dispatch" {
      effort 3d
      allocate team
      complete 100
      depends !open
      note "The app owns exactly ONE libarbc Document for its lifetime (process-per-project). Project-level selection and active tool; a command/action dispatch that turns UI actions into library transactions. Design: D19 / arch A4/A7. Refinement: tasks/refinements/editor/app_state.md"
    }
    task exec_new "Open-another-project = exec a new instance" {
      effort 1d
      allocate team
      complete 100
      depends !app_state
      note "Opening a different project execs a fresh editor process (its own Document/workspace/threads/window). No multi-project-in-one-window, no in-process switching. Design: D19. Refinement: tasks/refinements/editor/exec_new.md"
    }
    task save "Save = re-dump project.arbc + assets; dirty state" {
      effort 1.5d
      allocate team
      complete 100
      depends !app_state
      note "Save re-emits the canonical project.arbc (+ changed owned tiles) from the live workspace — a publish step, not a crash race (the workspace is durable by default). Dirty indicator = workspace-vs-snapshot drift. Design: D16 §9. Refinement: tasks/refinements/editor/save.md"
    }
    task save_as "Save As = publish + copy project dir + exec sibling" {
      effort 1d
      allocate team
      complete 100
      depends !save, !exec_new
      note "Save As: dump the current state, recursively copy project.arbc + assets/ to the chosen target (excluding workspace/, which the sibling regenerates), write the workspace/-excluding .gitignore, then hand the new directory to commands::open_another_project (editor.project.exec_new). Design: D16 §9 (Save As = copy the directory), A7/D19 (process-per-project). Source-of-debt: tasks/refinements/editor/save.md. Refinement: tasks/refinements/editor/save_as.md"
    }
    task undo "Undo/redo wired to library transactions" {
      effort 2d
      allocate team
      complete 100
      depends !app_state
      note "Undo/redo IS libarbc's transaction journal (doc 14), not a reimplementation; continuous gestures (a stroke, a drag) coalesce into one step. Viewport-camera navigation is transient (not undoable); a saved shot's framing is scene data (undoable). Design: D15. Refinement: tasks/refinements/editor/undo.md"
    }
    task gc "Clean up (GC)" {
      effort 2d
      allocate team
      complete 100
      depends !save
      note "Clean up runs the library's gc_project_directory over assets/ (roots = this one document); GC never touches workspace/ or borrowed files. Consolidate + relink split to editor.import.consolidate. Design: D13. Refinement: tasks/refinements/editor/gc.md"
    }
    task welcome "Welcome dialog: interactive no-arg launch offers New / Open / Recent" {
      effort 1.5d
      allocate team
      complete 100
      depends !open_ui
      note "Interactive no-arg launch (empty project_dir, non-headless) shows a modal welcome offering New / Open / Open Recent, backed by the dock::ProjectGateway (A12) the tool rail already uses. The launcher process owns NO Document: New/Open/Recent spawn a detached sibling on the chosen (or newly created) project directory (commands::open_another_project, spawn-not-swap, A7/D19) and the launcher then exits. Headless no-arg keeps auto-scratch (shell.cpp scratch_project_dir) so the driven path always holds a Document. Refines A7 (a pre-project launcher owns zero Documents; a project process still owns exactly one for its lifetime) and SUPERSEDES D-app_state-6 (scratch-when-none-given as the interactive default). Design: D16/D19/D22, arch A7/A12. Source-of-debt: tasks/refinements/editor/app_state.md. Refinement: tasks/refinements/editor/welcome.md. Decided (pre-exec 2026-07-19): dismissing/cancelling the welcome without choosing = the launcher EXITS cleanly (nothing to fall back to; keeps the zero-Document invariant absolute — a user wanting a throwaway chooses New). THREE verbs only (New / Open / Open Recent), matching D22 — no scratch/skip verb and no remembered-default in v1."
    }
    task entry_outcome "Distinguish refused-target from failed-spawn at the ProjectGateway seam" {
      effort 0.5d
      allocate team
      complete 100
      depends !welcome
      note "Replace the entry verbs' single bool return with a small dock-local outcome POD (e.g. ProjectEntryOutcome: succeeded / refused_target / spawn_failed) so dock::WelcomeWindow and dock::Dockspace can surface 'That folder is not a project.' vs 'Could not start the editor.' without inferring spawn failure from MRU state. Source-of-debt: tasks/refinements/editor/welcome.md (D-welcome deviation: Constraint 6 inference). Design: D22, arch A12. Refinement: tasks/refinements/editor/entry_outcome.md"
    }
    task save_as_outcome "Widen save_as to the outcome seam so a failed publish or exec stops reporting a name refusal" {
      effort 0.5d
      allocate team
      complete 100
      depends !entry_outcome
      note "AppProjectGateway::save_as (project_gateway.cpp:194-218) has four documented failure modes (dock.hpp:128-130: invalid name · target exists · failed publish · failed exec) collapsed into one bool; the entry_outcome leaf's adapter maps all four onto refused_target, preserving today's exact string. Resolving honestly needs a fourth enumerator (publish_failed) and a richer result from commands::save_project_as, which is L1 work outside the entry-verbs scope. Source-of-debt: tasks/refinements/editor/entry_outcome.md. Design: D22/D27, arch A12/A13. Refinement: tasks/refinements/editor/save_as_outcome.md"
    }
    task save_as_rollback "Remove a partially published Save As target when the publish fails" {
      effort 1d
      allocate team
      complete 100
      depends !save_as_outcome
      note "project::save_project_as creates the target tree before it can fail (src/project/save.cpp:195-239): a SaveError from the publish (:230) or from the gitignore write (:237) leaves a directory behind, and D27's guard (:205) then refuses the same name forever. save_as_outcome makes the message honest ('Could not save a copy there.'); making the state recoverable needs a recursive-remove faculty on platform::FileSystem (native impl + test double + A3 WASM seam), which is a new L0 method outside the 0.5d reporting change. Source-of-debt: tasks/refinements/editor/save_as_outcome.md. Design: D27, arch A3/A12/A13. Refinement: tasks/refinements/editor.project/save_as_rollback.md"
    }
    task create_rollback "Remove a partial project scaffold when create_project fails after its existence guard" {
      effort 0.5d
      allocate team
      complete 100
      depends !save_as_rollback
      note "project::create_project (src/project/project_open.cpp:301-352) has the identical shape as save_project_as: it refuses an existing target at :312-314, then scaffolds with four early returns (:321 mkdir loop, :327 gitignore write, :335 workspace-document mint, :339 checkpoint), each leaving a partial directory that D27's guard refuses forever. Deferred from save_as_rollback because two of the four failure branches occur after an mmap-backed arbc::Document has been minted over workspace/ (:332-340), so the rollback must destroy the Document before removing the tree — a destruction-ordering constraint the pure-write Save As path does not have. The primitive (platform::FileSystem::remove_tree), its native impl, and all six doubles shipped with save_as_rollback; this leaf adds the two call sites plus tests in tests/project_open_test.cpp. Source-of-debt: tasks/refinements/editor.project/save_as_rollback.md. Design: D27, arch A3. Refinement: tasks/refinements/editor.project/create_rollback.md"
    }
    task dir_is_project "Project = directory: New and Save As refuse any existing target" {
      effort 1d
      allocate team
      complete 100
      depends !open, !save_as
      note "The project directory IS the project (D16, project-as-a-directory): creation targets a path that does not yet exist, and the tool creates the directory. Tighten project::create_project (project_open.cpp) and project::save_project_as (save.cpp) to refuse ANY existing target directory — not just one already holding a project.arbc — so New and Save As behave identically; surface the refusal as a clear in-app message via dock::ProjectGateway. REVERSES D-save_as-4's narrow 'a populated directory without project.arbc is a fine destination' guard (flips the save_as_test populated-target case) and adds a create-time existence check to the open path. Design: D16 (project-as-a-directory), D19. Source-of-debt: tasks/refinements/editor/save_as.md, tasks/refinements/editor/open.md. Refinement: tasks/refinements/editor/dir_is_project.md. Decided (pre-exec 2026-07-19): New AND Save As collect the target via a parent-location pick + typed project NAME (not a folder picker returning an existing dir); the tool creates that directory. 'Existing' means exists-at-all — refuse even an EMPTY existing dir, for full New/Save-As symmetry. So Save As switches from the shipped native-folder-pick UX to the same parent+name compose flow New uses."
    }
    task raster_tile_store "Thread RasterTileStore/TileDecodeDispatch through save/open for raster memoisation" {
      effort 1.5d
      allocate team
      complete 100
      depends editor.cells.model
      note "Thread arbc::RasterTileStore (and TileDecodeDispatch) through project::save_project -> arbc::builtin_codecs(registry, &tiles) (document_serialize.hpp:134) and project::open_project -> arbc::load_document(..., tiles, decode) (:218) so raster-cell tiles are memoized across saves instead of re-hashed on every save. save.cpp:120 passes null tiles and project_open.cpp:97-98 passes none -- correct but O(all tiles) per save. editor.cells.model is the first leaf to put raster cells in a saved project, making this load-bearing. Source-of-debt: tasks/refinements/editor.cells/model.md. Design: docs/01-architecture.md A4/A14. Refinement: tasks/refinements/editor/raster_tile_store.md"
    }
    task reopen_degradation_notice "Surface unbindable-content count as a one-shot open notice" {
      effort 0.5d
      allocate team
      complete 100
      depends editor.cameras.reopen_slab_adopt
      note "Read OpenedProject::unbindable_content_records through the existing dock::ProjectGateway POD seam and show a one-shot notice on open naming how many objects the unsaved workspace could not recover, with an ImGui Test Engine e2e driving it headless by widget id. Source-of-debt: tasks/refinements/cameras/reopen_slab_adopt.md. Design: docs/01-architecture.md A19. Refinement: tasks/refinements/editor/reopen_degradation_notice.md"
    }
    task reconstructing_reopen "Restore the durable-by-default workspace fast path via the reconstructing reopen" {
      effort 3d
      allocate team
      complete 100
      depends editor.canvas.arbc_v040, !reopen_degradation_notice
      note "ruoso/arbitrarycomposer#19 shipped in v0.4.0 and answers A19's 'Future fix (cross-repo)' clause in BOTH the shapes it named. (a) A registry-aware open: `arbc::open_document(path, registry, codecs, bridge, ...)` (arbc/runtime/document_serialize.hpp:190) rebuilds each recovered content through the same routing `load_document` uses for a canonical file, because `ContentRecord` now carries the content's construction identity (reverse-DNS kind_id + the kind's canonical params) and its input edges, captured at `add_content` through the kind's own registered codec via `Document::set_content_identity_capture` (`arbc::codec_identity_capture(codecs, bridge)` is the ready-made one). (b) A public rebind seam: `Document::rebind_content(id, content)` binds an object to a record that already exists — the repair route `add_content` could not serve, since it mints a NEW id while the recovered layers, journal edges and state handles all name the old one. `Document::recovered_content_state()` ships with it, finally making the arbc#5 replay trio reachable from a host that opens through `Document` rather than `Model`. SCOPE. Install the identity capture on the create/open path so newly written workspaces carry construction identity; open through `open_document` in project::open_project (src/project/project_open.cpp:245) and RETIRE the content-bearing-map guard A19 consequence (2) describes — the map fast path becomes durable-by-default again, for every kind at once, which is D-open-3's original policy. A record that cannot be rebuilt (a plugin absent this session, a kind with no codec, a workspace written before v0.4.0) arrives in `ReopenedDocument::unreconstructed` and is left UNBOUND — never filled with a default-constructed stand-in — so it feeds the existing `OpenedProject::unbindable_content_records` count and editor.project.reopen_degradation_notice keeps working unchanged, now reporting a genuinely rare case instead of the common one. AMEND A19 in docs/01-architecture.md: its premise ('the map path binds no Content for any kind') no longer holds at the pinned version and its consequences (1)-(3) are superseded; retain the text as the historical record the way A15 was retained, and keep the never-saved-project residual honest — a created-but-never-saved project still has no canonical floor, but its map now reconstructs, which is the whole point. CARRIES THE DIRTY-PRECISION DECISION (promoted from tasks/parking-lot.md 'Cross-session dirty precision on mapped-workspace reopen', D-save-4, at the 2026-07-28 triage): restoring the fast path FLIPS the common reopen from clean to dirty. Today most reopens rebuild from canonical and start clean because that read proves sync; after this leaf most reopens map, and the session-scoped dirty model starts them dirty, so a project saved cleanly yesterday opens showing modified with Save armed and a pointless re-dump on first press. That is a visible regression this leaf introduces, so this leaf owns the answer — and the parked entry's own reason for deferring the fix ('would require touching the shipped open/create path') is void here, because this leaf touches exactly that path. Decide between a cross-session published-revision sidecar in workspace/ (the entry's proposal — a mapped reopen can then read CLEAN) and an explicit accepted false-dirty, but do not ship the flip unexamined; D-save-4's asymmetry stands either way — a false-clean tells the user their edits are safe in project.arbc when they are not, and is the unsafe direction. TEST IMPACT: most of tests/project_open_test.cpp's pinned cases invert. 'a workspace-mapped reopen restores the record graph but binds NO content' (:332) pins the retired premise and must be REWRITTEN to pin reconstruction, not deleted; ':407 rebuilds a content-bearing workspace', ':435 keeps the map for a content-free workspace' and ':461 a never-saved content-bearing project keeps the map and REPORTS the loss' all change meaning. Each inversion must be justified against the v0.4.0 changelog — these tests are the record of WHY the guard existed, and a silent rewrite loses it. SEE ALSO, not in scope: tasks/parking-lot.md 'Worker-backed parallel tile decode/encode' asks whether the WorkerPool's lifetime moves below render (an A4/A5 amendment). `open_document` takes the same LoadContext that carries the raster tile store, so a reconstructing reopen still decodes tiles INLINE — the cold-open cost moves from rebuild to map-plus-reconstruct rather than disappearing. This leaf ships correctly without answering that, but it is the cheapest moment to answer it, since it already owns an architecture amendment on this path. Source-of-debt: tasks/parking-lot.md 'arbc workspace-map reopen binds no Content' + 'Cross-session dirty precision on mapped-workspace reopen'. Design: docs/01-architecture.md A13/A19, docs/00-design.md D16, D-open-3. Refinement: tasks/refinements/editor.project/reconstructing_reopen.md"
    }
    task undo_reconcile "Route undo/redo through Document::undo/redo so a config rewrite rebinds its content" {
      effort 0.5d
      allocate team
      depends editor.canvas.arbc_v070
      note "ruoso/arbitrarycomposer#34 shipped `Document::undo()`/`redo()` in v0.5.0 — the journal navigation WRAPPED in `reconcile_content_bindings()`. `commands::undo`/`redo` currently drive `doc.journal().undo()`/`redo()` directly (src/commands/app_state.cpp:136,143), and upstream is explicit that a host navigating through `journal()` directly MUST call `reconcile_content_bindings()` itself (document.hpp:244-247). WHY THIS IS A LEAF AND NOT A LINE IN CONSOLIDATE: it is inert TODAY and stops being inert the instant anything calls `update_content_config` — the id->Content side-map is runtime state beside the model, so undoing a config rewrite would restore the PARAMS while leaving the live object built from the old ones, a silent divergence with no crash and no failing assertion to catch it. Landing the seam BEFORE its first caller means consolidate cannot introduce that window even briefly, and it keeps the two changes reviewable apart. Upstream states the wrapped calls are IDENTICAL to the raw ones for a document that never rewrote a config (the reconcile finds nothing stale and rebinds nothing), so this leaf is behaviour-preserving today and its proof obligation is exactly that: tests/undo_ui_e2e_test.cpp and every journal assertion pass UNMODIFIED. D15's `undo is the library's, never a reimplemented stack` is unchanged — this swaps one library entry point for a strictly wider one. Source-of-debt: tasks/parking-lot.md triage 2026-08-08 (arbc#34). Design: docs/00-design.md D15; docs/01-architecture.md A4.1."
    }
    task gc_owned_images "Land the GC-roots-owned-blob case the paste leaf could not satisfy" {
      effort 0.5d
      allocate team
      complete 100
      depends editor.canvas.arbc_v070, editor.import.paste
      note "ruoso/arbitrarycomposer#30 shipped in v0.5.0: `gc_project_directory` now marks `params.source` URIs alongside `params.blobs` hashes and sweeps `assets/images/` alongside `assets/tiles/`, both halves together. `editor.import.paste` shipped with its GC-roots-owned-blob acceptance criterion DELIBERATELY NOT LANDED because neither half was satisfiable against v0.4.1 — that is the debt this leaf pays. Land the deferred Catch2 case: a pasted owned image is ROOTED while referenced (a Clean-Up leaves its blob alone), and a paste->undo->save->Clean-Up cycle RECLAIMS the orphan. Both directions matter — the rooted half is the one whose absence would mean data loss, and it is the half that was unsatisfiable in the safe direction before (the old reaper ignored assets/images/ entirely, so nothing was ever wrongly deleted BECAUSE nothing was ever looked at). ALSO re-read, do not assume: upstream now matches an authored URI against an on-disk key OVER-APPROXIMATELY on purpose (a shared basename roots a blob) because retaining an orphan is a leak while failing to recognise a live reference is data loss — so a test asserting exact reclaim counts on colliding basenames would be asserting against the library's stated policy rather than a bug. A REFERENCED image, whose URI points outside the project's owned subtree, is never enumerated and can never be reclaimed; that is correct and worth a case of its own. Source-of-debt: tasks/refinements/editor/paste.md GC-roots-owned-blob escape clause; tasks/parking-lot.md `libarbc GC blind to owned image blobs` (arbc#30). Design: docs/00-design.md D13; docs/01-architecture.md A23. Refinement: tasks/refinements/editor.project/gc_owned_images.md"
    }
  }

  # ---- Canvas & rendering (A4/A5/A6) ----
  task canvas "Canvas & rendering" {
    task view "Canvas view = HostViewport + InteractiveRenderer; tile -> GL" {
      effort 3d
      allocate team
      complete 100
      depends editor.project.app_state
      note "A canvas view drives a libarbc HostViewport + InteractiveRenderer over the shared Document and uploads settled CPU tiles as GL textures. A GPU Backend later needs no editor change (behind the Backend seam). Arch A4/A6. Refinement: tasks/refinements/editor/canvas_view.md"
    }
    task frame_sync "UI-thread <-> driver frame handoff; edit submission" {
      effort 3d
      allocate team
      complete 100
      depends !view
      note "The driver renders off the UI thread; the UI displays the latest frame (double-buffer) and SUBMITS edits, never touching the cache. Honors the library's single-writer / leaf-only-dispatch contract. Arch A4. Refinement: tasks/refinements/editor/frame_sync.md"
    }
    task multi_canvas "N canvases over one Document sharing one WorkerPool" {
      effort 2d
      allocate team
      complete 100
      depends !frame_sync
      note "Multiple canvas views = multiple HostViewport/InteractiveRenderer over the one Document sharing one library WorkerPool; each cache render-thread-confined, so no new locking. This is 'paint through Viewport | look through Hero'. Arch A5 / D18. Refinement: tasks/refinements/editor/multi_canvas.md"
    }
    task nav "Pan / zoom the viewport camera; scale bar; deep zoom" {
      effort 2d
      allocate team
      complete 100
      depends !view
      note "Pan/zoom drives the active viewport camera (transient); a scale bar in composition units (no phantom %); deep-zoom rebasing surfaced from HostViewport. Design: D2. Refinement: tasks/refinements/editor/nav.md"
    }
    task tool_dispatch "Route ToolSelection into canvas pointer-gesture dispatch" {
      effort 2d
      allocate team
      complete 100
      depends editor.dock.tool_rail, editor.cells.gizmo, editor.canvas.nav
      note "Route dockmodel::ToolSelection active tool into the canvas interaction handler so a canvas pointer gesture dispatches per active tool (Select/Brush/Eyedropper/Pan); promote the tool->behavior seam into interact (hit-test/gizmo/brush math). Source of debt: tasks/refinements/editor/tool_rail.md (D20/A11). Design: docs/00-design.md D20, docs/01-architecture.md A11. Refinement: tasks/refinements/editor.canvas/tool_dispatch.md"
